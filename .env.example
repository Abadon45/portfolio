# Server-only Neon connection string. Never expose this as NEXT_PUBLIC_*.
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require"

# Required only for the protected schema inspection endpoint.
NEON_INSPECT_SECRET="replace-with-a-long-random-value"

# Neon Auth service configuration.
NEON_AUTH_BASE_URL="https://your-neon-auth-host/neondb/auth"
NEON_AUTH_JWKS_URL="https://your-neon-auth-host/neondb/auth/.well-known/jwks.json"
NEON_AUTH_COOKIE_SECRET="at-least-32-characters-long"

# Vercel Blob image storage. Keep both values server-only.
BLOB_READ_WRITE_TOKEN="set-this-from-your-vercel-blob-store"
BLOB_UPLOAD_SECRET_STORE_ID="set-this-from-your-vercel-blob-store"

# Email confirmation. Resend is used server-side for registration OTP delivery.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
AUTH_FROM_EMAIL="Portfolio <onboarding@your-verified-domain.com>"

# Google OAuth. Keep the secret server-only.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Optional; defaults to http://localhost:3000/api/auth/google/callback locally.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# GitHub OAuth. Create an OAuth App in GitHub Developer Settings.
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"
# Optional; defaults to http://localhost:3000/api/auth/github/callback locally.
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/github/callback"

# Microsoft OAuth. Use the common tenant for personal and organizational accounts.
MICROSOFT_CLIENT_ID="your-microsoft-application-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-application-client-secret"
# Optional; defaults to http://localhost:3000/api/auth/microsoft/callback locally.
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/auth/microsoft/callback"
MICROSOFT_TENANT="common"

# Facebook Login. Add the callback URL in the Facebook app's Valid OAuth Redirect URIs.
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"
# Optional; defaults to http://localhost:3000/api/auth/facebook/callback locally.
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/auth/facebook/callback"

# Xendit invoice checkout. Keep both values server-only.
XENDIT_API_KEY="xnd_test_or_live_key"
XENDIT_WEBHOOK_TOKEN="set-this-from-xendit-webhook-settings"
