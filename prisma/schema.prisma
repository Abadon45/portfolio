generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["portfolio_auth", "saas_demo"]
}

model email_verifications {
  id         String   @id
  user_id    String
  code_hash  String
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "portfolio_auth_email_verifications_user_id_idx")
  @@schema("portfolio_auth")
}

model sessions {
  id         String   @id
  user_id    String
  token_hash String   @unique
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "portfolio_auth_sessions_expires_at_idx")
  @@index([user_id], map: "portfolio_auth_sessions_user_id_idx")
  @@schema("portfolio_auth")
}

model sned_categories {
  id             String         @id
  language_id    String
  name           String
  slug           String
  description    String
  sort_order     Int            @default(0)
  sned_languages sned_languages @relation(fields: [language_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sned_items     sned_items[]

  @@unique([language_id, slug])
  @@index([language_id, sort_order], map: "portfolio_auth_sned_categories_language_idx")
  @@schema("portfolio_auth")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sned_items {
  id              String          @id
  category_id     String
  word            String
  slug            String
  description     String
  image_url       String?
  image_alt       String?
  video_url       String?
  video_provider  String?
  source_name     String?
  source_url      String?
  creator         String?
  license         String?
  status          String          @default("draft")
  is_demo         Boolean         @default(false)
  sort_order      Int             @default(0)
  sned_categories sned_categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sned_progress   sned_progress[]

  @@unique([category_id, slug])
  @@index([category_id, status, sort_order], map: "portfolio_auth_sned_items_category_idx")
  @@schema("portfolio_auth")
}

model sned_languages {
  id              String            @id
  code            String            @unique
  name            String
  description     String
  sort_order      Int               @default(0)
  sned_categories sned_categories[]

  @@schema("portfolio_auth")
}

model sned_progress {
  user_id        String
  item_id        String
  completed      Boolean    @default(false)
  completed_at   DateTime?  @db.Timestamptz(6)
  practice_count Int        @default(0)
  updated_at     DateTime   @default(now()) @db.Timestamptz(6)
  sned_items     sned_items @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, item_id])
  @@index([item_id], map: "portfolio_auth_sned_progress_item_id_idx")
  @@schema("portfolio_auth")
}

model teacher_schedule_entries {
  id                String            @id
  schedule_id       String
  day               String
  start_time        String
  end_time          String
  subject           String
  section           String?
  room              String?
  notes             String?
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  teacher_name      String            @default("")
  year_level        String            @default("All Year Levels")
  school_level      String            @default("JHS")
  teacher_schedules teacher_schedules @relation(fields: [schedule_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([schedule_id], map: "portfolio_auth_teacher_schedule_entries_schedule_id_idx")
  @@schema("portfolio_auth")
}

model teacher_schedules {
  id                       String                     @id
  user_id                  String
  name                     String
  academic_period          String?
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  school_year              String                     @default("Unspecified")
  term                     String                     @default("Full School Year")
  source_loads             Json                       @default("[]")
  quality_metrics          Json                       @default("{}")
  teacher_schedule_entries teacher_schedule_entries[]
  users                    users                      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "portfolio_auth_teacher_schedules_user_id_idx")
  @@schema("portfolio_auth")
}

model user_identities {
  id               String   @id
  user_id          String
  provider         String
  provider_user_id String
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  users            users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, provider_user_id])
  @@index([user_id], map: "portfolio_auth_user_identities_user_id_idx")
  @@schema("portfolio_auth")
}

model users {
  id                  String                @id
  email               String                @unique
  display_name        String
  password_hash       String
  role                String                @default("viewer")
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  email_verified_at   DateTime?             @db.Timestamptz(6)
  first_name          String?
  last_name           String?
  full_name           String?
  username            String?
  avatar_url          String?
  phone               String?
  is_active           Boolean               @default(true)
  last_login          DateTime?             @db.Timestamptz(6)
  auth_provider       String                @default("password")
  provider_user_id    String?
  user_type           String                @default("regular_user")
  setup_completed     Boolean               @default(true)
  email_verifications email_verifications[]
  sessions            sessions[]
  sned_progress       sned_progress[]
  teacher_schedules   teacher_schedules[]
  user_identities     user_identities[]

  @@unique([auth_provider, provider_user_id], map: "portfolio_auth_google_identity_idx", where: raw("(provider_user_id IS NOT NULL)"))
  @@schema("portfolio_auth")
}

model affiliate_links {
  id         String  @id
  product    String
  slug       String  @unique
  clicks     Int     @default(0)
  orders     Int     @default(0)
  revenue    Decimal @default(0) @db.Decimal(14, 2)
  commission Decimal @default(0) @db.Decimal(14, 2)

  @@schema("saas_demo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_movements {
  id             String   @id
  product_id     String
  movement_type  String
  quantity       Int
  reference      String
  reference_type String
  user_name      String
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  products       products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "saas_demo_inventory_movements_product_id_idx")
  @@schema("saas_demo")
}

model orders {
  id         String  @id
  customer   String
  store      String
  product    String
  quantity   Int
  total      Decimal @db.Decimal(14, 2)
  status     String
  order_date String
  order_type String  @default("storefront")

  @@schema("saas_demo")
}

model payouts {
  id          String  @id
  payout_date String
  amount      Decimal @db.Decimal(14, 2)
  method      String
  status      String
  reference   String

  @@schema("saas_demo")
}

model price_requests {
  id             String   @id
  product        String
  current_price  Decimal  @db.Decimal(12, 2)
  proposed_price Decimal  @db.Decimal(12, 2)
  reason         String
  status         String
  reviewer       String
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@schema("saas_demo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id                  String                @id
  supplier_product_id String                @unique
  inventory_id        String                @unique
  name                String
  sku                 String                @unique
  category            String
  supplier            String
  supplier_price      Decimal               @default(0) @db.Decimal(12, 2)
  price               Decimal               @default(0) @db.Decimal(12, 2)
  margin              Decimal               @default(0) @db.Decimal(5, 2)
  stock               Int                   @default(0)
  reserved            Int                   @default(0)
  available           Int                   @default(0)
  reorder_point       Int                   @default(0)
  reorder_quantity    Int                   @default(0)
  commission_rate     Decimal               @default(0) @db.Decimal(5, 2)
  status              String                @default("Active")
  sold                Int                   @default(0)
  revenue             Decimal               @default(0) @db.Decimal(14, 2)
  featured            Boolean               @default(false)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  inventory_movements inventory_movements[]

  @@schema("saas_demo")
}

model settlements {
  id      String  @id
  period  String
  orders  Int
  gross   Decimal @db.Decimal(14, 2)
  fees    Decimal @db.Decimal(14, 2)
  payable Decimal @db.Decimal(14, 2)
  status  String

  @@schema("saas_demo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model store_products {
  slug                   String    @id
  sku                    String    @unique
  name                   String
  category_1             String
  category_2             String
  category               String
  shop                   String
  customer_price         Decimal   @default(0) @db.Decimal(12, 2)
  description_1          String    @default("")
  description_2          String?
  advantage              String?
  feature                String?
  specification          String?
  images                 Json      @default("[]")
  source_quantity        Int       @default(0)
  stock                  Int?
  unlimited_stock        Boolean   @default(false)
  barley_point           Decimal   @default(0) @db.Decimal(12, 2)
  shipping_quantity      Decimal   @default(1) @db.Decimal(12, 2)
  for_virtual_warehouse  Boolean   @default(false)
  is_visible             Boolean   @default(true)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)
  image_sources          Json      @default("[]")
  source_product_id      String?
  source_snapshot_at     DateTime? @db.Timestamptz(6)
  status                 String    @default("active")
  currency               String    @default("PHP")
  compare_at_price       Decimal?  @db.Decimal(12, 2)
  weight_grams           Decimal?  @db.Decimal(12, 3)
  length_cm              Decimal?  @db.Decimal(12, 3)
  width_cm               Decimal?  @db.Decimal(12, 3)
  height_cm              Decimal?  @db.Decimal(12, 3)
  shipping_profile       String?
  minimum_order_quantity Int       @default(1)
  maximum_order_quantity Int?
  is_featured            Boolean   @default(false)
  sort_order             Int       @default(0)
  seo_title              String?
  seo_description        String?
  brand                  String?

  @@schema("saas_demo")
}

model subscriptions {
  id            String  @id
  plan          String
  status        String
  monthly_price Decimal @db.Decimal(12, 2)
  renewal_date  String
  usage_percent Int
  stores        Int

  @@schema("saas_demo")
}
